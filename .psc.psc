Algoritmo area_y_perimetro_de_un_rectángulo
	definir base, altura, area , perimetro como real;
	escribir " Ingrese la base del tablero (En Metros)";
	Leer base;
	escribir " Ingrese la altura del tablero (En Metros)";
	leer altura;
	area <- base * altura;
	perimetro <- 2 * (base + altura);
	Escribir "El área del tablero es: ",area," Metros cuadrados."
	Escribir "El perímetro del tablero es: ", perimetro, " Metros cuadrados.";
FinAlgoritmo






